{
  "name": "v4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3160",
    "build": "prisma contract emit && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:s3": "vitest run --config vitest.integration.s3.config.ts",
    "contract:emit": "prisma contract emit",
    "db:plan": "prisma contract emit && prisma migration plan --name",
    "db:migrate": "prisma db migrate",
    "db:migrate:dev": "prisma db migrate --advance-ref db",
    "db:verify": "prisma db verify",
    "db:seed": "tsx src/bin/seed.ts",
    "db:reset": "tsx src/bin/reset-db.ts",
    "prepare": "husky",
    "worker": "tsx src/bin/worker.ts",
    "media:backfill": "tsx src/bin/backfill-media.ts",
    "media:migrate-s3": "tsx src/bin/migrate-media-to-s3.ts",
    "s3:setup": "tsx src/bin/s3-setup.ts",
    "photos:move-top-level": "tsx src/bin/move-top-level-photos.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/lib-storage": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@con2/components": "github:con2/components#v5.1.0",
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "bootstrap": "5.3.8",
    "lru-cache": "11.5.3",
    "next": "16.3.7",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.8",
    "nodemailer": "^7.0.13",
    "pg": "8.22.0",
    "react": "19.3.0",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "yazl": "2.5.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.3.0",
    "@prisma/orm-toolchain": "8.0.0-rc.9",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "@smithy/types": "^4.19.0",
    "@types/node": "24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "prisma": "8.0.0-rc.13",
    "sass": "1.105.1",
    "typescript": "^5",
    "vitest": "5.0.2",
    "yauzl": "3.4.0"
  },
  "type": "module",
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "prettier": {}
}
