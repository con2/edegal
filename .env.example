# Copy to .env for local development. All values have safe dev defaults in src/config.ts;
# only DATABASE_URL is mandatory.
DATABASE_URL=postgresql://edegal:photos@localhost:5432/edegal
TEST_DATABASE_URL=postgresql://edegal:photos@localhost:5432/edegal_test

# Where media files live (pictures/, previews/, thumbnails/, downloads/) and the URL prefix they are served from.
MEDIA_ROOT=./media
MEDIA_BASE_URL=/media

# S3-compatible media storage. With a bucket set, new uploads go to it and are served with presigned
# URLs; unset, media stays under MEDIA_ROOT. `docker compose up -d && scripts/garage-init.sh` prints
# working values for the local Garage (README.md, "Media in Garage"). Run `npm run s3:setup` once
# per bucket to allow browser uploads (CORS). The TEST_S3_* twins feed `npm run test:integration:s3`.
# S3_ENDPOINT=http://localhost:3900
# S3_PUBLIC_ENDPOINT=http://localhost:3900
# S3_REGION=garage
# S3_BUCKET=edegal
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# TEST_S3_ENDPOINT=http://localhost:3900
# TEST_S3_BUCKET=edegal-test
# TEST_S3_ACCESS_KEY_ID=
# TEST_S3_SECRET_ACCESS_KEY=

# Kompassi OIDC (dev.kompassi.eu client registered by the owner)
KOMPASSI_BASE_URL=https://dev.kompassi.eu
KOMPASSI_OIDC_CLIENT_ID=kompassi-dev-client-id-uusi-larppikuvat-fi
KOMPASSI_OIDC_CLIENT_SECRET=kompassi-dev-client-secret-uusi-larppikuvat-fi-insecure
PHOTOGRAPHER_GROUP=larppikuvat-staff
ADMIN_GROUP=admins

AUTH_URL=http://localhost:3160
AUTH_SECRET=insecure-dev-secret

# Outgoing mail for the contact form. Left unset, messages are printed to the terminal instead.
# SMTP_HOSTNAME=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_SENDER=edegal@localhost
# FORMATTED_MAIL_FROM=Edegal <edegal@localhost>
