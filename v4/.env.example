# Copy to .env for local development. All values have safe dev defaults in src/config.ts;
# only DATABASE_URL is mandatory.
DATABASE_URL=postgresql://edegal:photos@localhost:5432/edegal
TEST_DATABASE_URL=postgresql://edegal:photos@localhost:5432/edegal_test

# Where media files live (pictures/, previews/, thumbnails/, downloads/) and the URL prefix they are served from.
MEDIA_ROOT=./media
MEDIA_BASE_URL=/media

# Kompassi OIDC (dev.kompassi.eu client registered by the owner)
KOMPASSI_BASE_URL=https://dev.kompassi.eu
KOMPASSI_OIDC_CLIENT_ID=kompassi-dev-client-id-uusi-larppikuvat-fi
KOMPASSI_OIDC_CLIENT_SECRET=kompassi-dev-client-secret-uusi-larppikuvat-fi-insecure
PHOTOGRAPHER_GROUP=larppikuvat-staff
ADMIN_GROUP=admins

NEXTAUTH_URL=http://localhost:3160
AUTH_SECRET=insecure-dev-secret

LEGACY_ENABLED=true
LEGACY_ADMIN_URL=https://larppikuvat.fi/admin/
