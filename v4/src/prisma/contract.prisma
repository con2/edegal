// use prisma-next

// Tables and types are prefixed v4_ because they share the public schema with the
// legacy Django tables (edegal_*), which this contract deliberately does not describe.
native_enum AlbumVisibility {
  public = "public"
  hidden = "hidden"
  private = "private"

  @@map("v4_album_visibility")
}

native_enum MediaRole {
  original = "original"
  preview = "preview"
  thumbnail = "thumbnail"

  @@map("v4_media_role")
}

native_enum MediaJobStatus {
  pending = "pending"
  running = "running"
  done = "done"
  failed = "failed"

  @@map("v4_media_job_status")
}

native_enum MediaFormat {
  jpeg = "jpeg"
  webp = "webp"
  avif = "avif"
  heif = "heif"

  @@map("v4_media_format")
}

model User {
  id           Uuid                       @id @default(uuid(7))
  sub          String                     @unique
  email        String                     @default("")
  displayName  String                     @default("") @map("display_name")
  createdAt    TimestamptzString          @default(now()) @map("created_at")
  updatedAt    temporal.updatedAtString() @map("updated_at")

  albums       Album[]
  photographer Photographer?
  terms        Terms[]
  photos       Photo[]

  @@map("v4_user")
}

model Photographer {
  id             Uuid                       @id @default(uuid(7))
  slug           String                     @unique
  displayName    String                     @map("display_name")
  email          String                     @default("")
  introduction   String                     @default("")
  userId         Uuid?                      @unique @map("user_id")
  user           User?                      @relation(fields:[userId], references:[id], onDelete: SetNull)
  defaultTermsId Uuid?                      @map("default_terms_id")
  defaultTerms   Terms?                     @relation(fields:[defaultTermsId], references:[id], onDelete: SetNull)
  createdAt      TimestamptzString          @default(now()) @map("created_at")
  updatedAt      temporal.updatedAtString() @map("updated_at")

  links          PhotographerLink[]
  credits        AlbumCredit[]

  @@map("v4_photographer")
}

model PhotographerLink {
  id             Uuid         @id @default(uuid(7))
  photographerId Uuid         @map("photographer_id")
  photographer   Photographer @relation(fields:[photographerId], references:[id], onDelete: Cascade)
  href           String
  title          String
  ordering       Int          @default(0)

  @@index([photographerId, ordering])
  @@map("v4_photographer_link")
}

// Reusable conditions of use. An album without its own uses the nearest ancestor's; the
// root album's terms are therefore the site default.
model Terms {
  id            Uuid                       @id @default(uuid(7))
  title         String
  text          String
  url           String                     @default("")
  ownerId       Uuid?                      @map("owner_id")
  owner         User?                      @relation(fields:[ownerId], references:[id], onDelete: SetNull)
  createdAt     TimestamptzString          @default(now()) @map("created_at")
  updatedAt     temporal.updatedAtString() @map("updated_at")

  albums        Album[]
  photographers Photographer[]

  @@map("v4_terms")
}

model Album {
  id                 Uuid                       @id @default(uuid(7))
  parentId           Uuid?                      @map("parent_id")
  parent             Album?                     @relation("AlbumTree", fields:[parentId], references:[id], onDelete: Restrict)
  children           Album[]                    @relation("AlbumTree")
  slug               String
  path               String                     @unique
  title              String
  body               String                     @default("")
  visibility         pg.enum(AlbumVisibility)   @default("public")
  isOpenForSubalbums Boolean                    @default(false) @map("is_open_for_subalbums")
  eventMetadataUrl   String                     @default("") @map("event_metadata_url")
  ordering           Int                        @default(0)
  eventDate          DateString                 @default(dbgenerated("current_date")) @map("event_date")
  isDownloadable     Boolean                    @default(true) @map("is_downloadable")
  termsId            Uuid?                      @map("terms_id")
  terms              Terms?                     @relation(fields:[termsId], references:[id], onDelete: SetNull)
  ownerId            Uuid?                      @map("owner_id")
  owner              User?                      @relation(fields:[ownerId], references:[id], onDelete: SetNull)
  thumbnailIsAuto    Boolean                    @default(true) @map("thumbnail_is_auto")
  thumbnailPhotoId   Uuid?                      @map("thumbnail_photo_id")
  thumbnailPhoto     Photo?                     @relation("AlbumThumbnail", fields:[thumbnailPhotoId], references:[id], onDelete: SetNull)
  createdAt          TimestamptzString          @default(now()) @map("created_at")
  updatedAt          temporal.updatedAtString() @map("updated_at")

  photos             Photo[]                    @relation("AlbumPhotos")
  credits            AlbumCredit[]

  @@unique([parentId, slug])
  @@index([parentId, ordering, eventDate])
  @@map("v4_album")
}

model AlbumCredit {
  albumId        Uuid         @map("album_id")
  album          Album        @relation(fields:[albumId], references:[id], onDelete: Cascade)
  photographerId Uuid         @map("photographer_id")
  photographer   Photographer @relation(fields:[photographerId], references:[id], onDelete: Restrict)
  isCopyright    Boolean      @default(false) @map("is_copyright")
  description    String       @default("")
  ordering       Int          @default(0)

  @@id([albumId, photographerId])
  @@map("v4_album_credit")
}

model Photo {
  id          Uuid               @id @default(uuid(7))
  albumId     Uuid               @map("album_id")
  album       Album              @relation("AlbumPhotos", fields:[albumId], references:[id], onDelete: Cascade)
  slug        String
  path        String             @unique
  title       String             @default("")
  ordering    Int                @default(0)
  takenAt     TimestamptzString? @map("taken_at")
  createdById Uuid?              @map("created_by_id")
  createdBy   User?              @relation(fields:[createdById], references:[id], onDelete: SetNull)
  createdAt   TimestamptzString  @default(now()) @map("created_at")

  media       Media[]
  jobs        MediaJob[]
  thumbnailOf Album[]            @relation("AlbumThumbnail")

  @@unique([albumId, slug])
  @@index([albumId, ordering, takenAt, slug])
  @@map("v4_photo")
}

model Media {
  id         Uuid                 @id @default(uuid(7))
  photoId    Uuid                 @map("photo_id")
  photo      Photo                @relation(fields:[photoId], references:[id], onDelete: Cascade)
  role       pg.enum(MediaRole)
  format     pg.enum(MediaFormat)
  width      Int
  height     Int
  storageKey String               @unique @map("storage_key")
  byteSize   Int?                 @map("byte_size")
  createdAt  TimestamptzString    @default(now()) @map("created_at")

  @@unique([photoId, role, format])
  @@map("v4_media")
}

// Background work queued at upload time: previews and thumbnails for one photo.
model MediaJob {
  id         Uuid                    @id @default(uuid(7))
  photoId    Uuid                    @map("photo_id")
  photo      Photo                   @relation(fields:[photoId], references:[id], onDelete: Cascade)
  status     pg.enum(MediaJobStatus) @default("pending")
  attempts   Int                     @default(0)
  error      String                  @default("")
  createdAt  TimestamptzString       @default(now()) @map("created_at")
  startedAt  TimestamptzString?      @map("started_at")
  finishedAt TimestamptzString?      @map("finished_at")

  @@index([status, createdAt])
  @@map("v4_media_job")
}
